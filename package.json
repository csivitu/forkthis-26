{
  "name": "forkthis-26",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "prettier": "3.9.6",
    "turbo": "^2.10.11",
    "typescript": "7.0.2",
    "pino-pretty": "^13.1.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@repo/db": "workspace:*",
    "dev": "^0.1.5",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "@repo/db": "workspace:*"
  },
  "overrides": {
    "drizzle-orm": "0.44.7"
  }
}
