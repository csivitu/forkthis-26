{
  "name": "api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "start": "bun --env-file=../../.env dist/index.js",
    "sync:prs": "bun --env-file=../../.env src/scripts/sync-prs.ts",
    "seed:test": "bun --env-file=../../.env src/scripts/seed-test-data.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.3.0",
    "bun-types": "^1.4.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "better-auth": "^1.7.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "graphql": "^17.0.2",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.4.3"
  }
}
